# REQUIRED: replace with a long random secret before deployment
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
TZ=Asia/Phnom_Penh

# Create a Django admin user with: python manage.py createsuperuser
# QIMA portal credentials are read only by the automation worker.
QIMA_USER=
QIMA_PASS=
QIMA_HEADLESS=true
QIMA_DRY_RUN=true
QIMA_TIMEOUT_SECONDS=3600
